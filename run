#!/bin/bash
# Builds a patched QEMU (anti-detection + hypercall quirk disabled) and installs
# the kvm-hypercall-patch DKMS module that makes vmcall/vmmcall raise #UD.
set -euo pipefail

QEMU_VERSION="${QEMU_VERSION:-11.1.3}"
PREFIX="${PREFIX:-/usr}"
HERE="$(cd "$(dirname "$0")" && pwd)"
SRC="$HERE/build/qemu-$QEMU_VERSION"

mkdir -p "$HERE/build"
cd "$HERE/build"

if [[ ! -f "qemu-$QEMU_VERSION.tar.xz" ]]; then
    curl -fLO "https://download.qemu.org/qemu-$QEMU_VERSION.tar.xz"
fi

# Always start from a pristine tree so the patch applies exactly once
rm -rf "$SRC"
[[ ! -e "$SRC" ]] || { echo "Could not remove $SRC (root-owned files? try: sudo rm -rf $SRC)"; exit 1; }
tar xf "qemu-$QEMU_VERSION.tar.xz"
cd "$SRC"
patch -p1 --batch -N < "$HERE/qemu-$QEMU_VERSION.patch"

export CFLAGS="-O3 -pipe -march=native -mtune=native -fomit-frame-pointer -flto=auto -fno-semantic-interposition"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-flto=auto -Wl,-O2 -Wl,--as-needed"

./configure \
    --target-list=x86_64-softmmu \
    --enable-kvm \
    --enable-linux-aio \
    --disable-werror \
    --disable-debug-info \
    --enable-lto \
    --prefix="$PREFIX"

make -j"$(nproc)"
sudo make install

echo "Installing kvm-hypercall-patch DKMS module"
cd "$HERE/kvm-hypercall-patch"
sudo dkms remove kvm-hypercall-patch/1.0 --all 2>/dev/null || true
sudo dkms install .

echo "Persisting module load at boot"
echo kvm-hypercall-patch | sudo tee /etc/modules-load.d/kvm-hypercall-patch.conf >/dev/null
sudo modprobe kvm-hypercall-patch || true

echo "Done. Fully shut down and restart the VM so it uses the new QEMU."
